{
  "name": "home-inspection-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/workflow.test.mjs",
    "test:integration": "node tests/integration.mjs && node tests/lifecycle.integration.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "license": "MIT",
  "description": "繁體中文裝潢驗收：平面圖、照片、設計師進度與逐輪驗收",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/old4693000-byte/home-inspection.git"
  }
}
